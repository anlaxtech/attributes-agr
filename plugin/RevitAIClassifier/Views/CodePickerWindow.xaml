<Window x:Class="RevitAIClassifier.Views.CodePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор кода классификатора" Width="640" Height="520" MinWidth="420" MinHeight="300"
        WindowStartupLocation="Manual" WindowStyle="ToolWindow" ShowInTaskbar="False"
        Background="#F3F3F3" FontSize="13">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" x:Name="TargetText" Foreground="#555" Margin="2,0,0,6"
                   TextTrimming="CharacterEllipsis"/>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Padding="6,4" TextChanged="SearchBox_TextChanged"
                     PreviewKeyDown="SearchBox_PreviewKeyDown"/>
            <TextBlock Text="Поиск: часть кода или наименования, например «балкон» или «301830»"
                       Foreground="#9E9E9E" Margin="9,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" x:Name="Placeholder"/>
        </Grid>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <CheckBox x:Name="OnlyUsed" Content="★ только коды из разметки" VerticalAlignment="Center"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Выбрать" Padding="16,4" Margin="6,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="Отмена" Padding="16,4" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="Results" MouseDoubleClick="Results_MouseDoubleClick"
                 PreviewKeyDown="Results_PreviewKeyDown" HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="{Binding Indent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Code}" FontFamily="Consolas" Foreground="#444"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}"/>
                        <TextBlock Grid.Column="2" Text="{Binding UsedText}" Foreground="#C08000"
                                   HorizontalAlignment="Right" ToolTip="Сколько типов размечено этим кодом"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
